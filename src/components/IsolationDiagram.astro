<div class="illustration-panel" id="isolation-diagram">
  <p class="illustration-badge">Illustration — not a working computation</p>
  <p class="illustration-intro">
    Nothing on this panel is computed. Real memory isolation happens in
    dedicated CPU circuitry that a browser has no access to — see <a href="/how-it-works">how it works</a> for why. This is a
    step-by-step sketch of what happens on real hardware when an enclave is
    created and used. Click a step.
  </p>

  <div class="illustration-steps" id="isolation-steps">
    <button type="button" class="illustration-step active" data-step="0">1. Create</button>
    <button type="button" class="illustration-step" data-step="1">2. Load &amp; measure</button>
    <button type="button" class="illustration-step" data-step="2">3. Initialize</button>
    <button type="button" class="illustration-step" data-step="3">4. Isolate</button>
    <button type="button" class="illustration-step" data-step="4">5. World-switch</button>
    <button type="button" class="illustration-step" data-step="5">6. Attest</button>
  </div>

  <div class="illustration-detail" id="isolation-detail"></div>
</div>

<script>
  const steps = [
    {
      title: '1. Create',
      body: 'An untrusted application asks the CPU to set aside a protected region of memory for a new enclave. The CPU allocates this region from a special, hardware-reserved pool — normal software, including the operating system, cannot address it directly.',
    },
    {
      title: '2. Load & measure',
      body: 'The enclave’s code and initial data are copied into that protected region, one page at a time. As each page is added, the CPU updates a running cryptographic hash of everything loaded so far — this hash is the "measurement" the attestation demo computes.',
    },
    {
      title: '3. Initialize',
      body: 'Once all pages are loaded, the CPU finalizes the measurement and locks the enclave — no further code or data can be added. From this point on, the enclave’s identity (in real SGX: called MRENCLAVE) is fixed.',
    },
    {
      title: '4. Isolate',
      body: 'While the enclave runs, the CPU enforces hardware access control on every single memory access: only instructions executing inside this specific enclave may read or write its pages. The operating system, hypervisor, and every other process are blocked at the hardware level — not by permission bits software could bypass, but by circuitry.',
    },
    {
      title: '5. World-switch',
      body: 'Every time execution moves between "inside the enclave" and "outside it" — an interrupt, a system call, a function return — the CPU saves and clears register state so secrets never leak into the untrusted world, then restores it on the way back in. This transition is called a world-switch, and it happens far more often than most software ever notices.',
    },
    {
      title: '6. Attest',
      body: 'On request, the enclave can ask the hardware to produce a signed statement of its own measurement — a "quote" — for a remote party to check. This is the one step in this whole diagram that this site’s interactive demo actually computes for real; see the working demo above.',
    },
  ];

  const buttons = document.querySelectorAll<HTMLButtonElement>('#isolation-steps .illustration-step');
  const detailEl = document.getElementById('isolation-detail')!;

  function render(i: number) {
    const step = steps[i];
    detailEl.innerHTML = `<h4>${step.title}</h4><p>${step.body}</p>`;
    buttons.forEach((b) => b.classList.toggle('active', Number(b.dataset.step) === i));
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => render(Number(btn.dataset.step)));
  });

  render(0);
</script>

